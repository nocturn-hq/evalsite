MONGO_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER_HOST/evalsite?retryWrites=true&w=majority
# Must be long and random, or anyone could forge a login. Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=PASTE_A_LONG_RANDOM_VALUE_HERE
ADMIN_EMAIL=youradmin@gmail.com
PORT=3000
# Only needed if your host puts a proxy in front of the server and it is not detected automatically (Render/Railway/Fly are).
# TRUST_PROXY=1
# Forgot the admin panel password? Set this to true once, restart, create a new one, then remove it.
# RESET_ADMIN_PASSWORD=true
